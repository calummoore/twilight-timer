{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twilight-timer",
  "compatibility_date": "2026-10-01",
  // Pull request previews open at <alias>-twilight-timer.futex.workers.dev.
  // Each deploy keeps this setting, so previews stay on.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
