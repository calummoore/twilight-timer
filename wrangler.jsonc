{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twilight-timer",
  "compatibility_date": "2026-10-01",
  // Production opens at https://ti4.nexus. Each deploy attaches this Custom
  // Domain, and Cloudflare makes its DNS record and its certificate. Each
  // deploy also removes a Custom Domain that this list does not name.
  "routes": [{ "pattern": "ti4.nexus", "custom_domain": true }],
  // Production also opens at https://twilight-timer.futex.workers.dev. When a
  // route is set, Wrangler turns that URL off unless this setting is true.
  "workers_dev": true,
  // Pull request previews open at <name>-twilight-timer.futex.workers.dev.
  // Workers Previews need this setting for those URLs. Each deploy keeps it,
  // so previews stay on.
  "preview_urls": true,
  // `wrangler preview` needs this block. The app has no bindings or
  // variables, so the block is empty. Previews use the assets setting below.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
